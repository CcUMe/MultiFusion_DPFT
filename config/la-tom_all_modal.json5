{
    "dataset": "kradar",

    "computing": {
        "dtype": "float32",
        "seed": 42,
        "workers": 16,
        "device": "cuda:0"
    },

    "data": {
        "revision": "",
        "image_size": 512,
        // 新增红外
        "ir_image": 512,
        "lidar": 1,
        "lidar_dropout": 0.0,
        "label_mode": "strict_3d",
        "weak_label": {
            "bbox_mode": "middle_slice",
            "line_mode": "source_yaw",
            "include_radar_labels": false,
            "class_depth_ratios": {
                "0": 0.4,
                "1": 0.65,
                "2": 0.6,
                "3": 0.6,
                "4": 0.9,
                "5": 1.0,
                "6": 1.0
            },
            "class_bbox_scales": {
                "0": 1.05,
                "1": 1.05,
                "2": 1.1,
                "3": 1.1,
                "4": 1.15,
                "5": 1.15,
                "6": 1.15
            }
        },
        "num_classes": 8,
        "subset": null,
        "categories": {
            "Sedan": 0,
            "Bus or Truck": 1,
            "Motorcycle": 2,
            "Bicycle": 3,
            "Bicycle Group": 4,
            "Pedestrian": 5,
            "Pedestrian Group": 6,
            "Background": -1
        },
        "fov": {
            "x": [
                0.0,
                72.0
            ],
            "y": [
                -6.4,
                6.4
            ],
            "z": [
                -2.0,
                6.0
            ],
            "azimuth": [
                -50,
                50
            ]
        }
    },

    "train": {
        "batch_size": 16,
        "shuffle": true,
        "epochs": 280,
        "logging": "epoch",
        "optimizer": {
            "name": "AdamW",
            "lr": 0.0001,
            "weight_decay": 0.01
        },
        "anassigner": "HungarianAnassigner",
        "criterion": "BalancedGroupSetCriterion",
        "background_weight": 0.1,
        "others_sample_ratio": 4,
        "loss_weights": {
            "objectness": 1.0,
            "bags_class": 1.0,
            "center": 1.0,
            "size": 1.0,
            "angle": 1.0
        },
        "scheduler": {
            "name": "CosineAnnealingLR",
            "T_max": 80,
            "eta_min": 0.000001
        },
        "weak_anassigner": "WeakBEVHungarianAnassigner",
        "weak_criterion": "WeakBEVSetCriterion",
        "weak_loss_weights": {
            "objectness": 1.0,
            "bags_class": 1.0,
            "center": 1.0,
            "size_lh": 1.0
        }
    },

    "model": {
        "name": "dprt",
        "inputs": [
            "camera_mono",
            // 新增红外
            "ir_image",
            "radar_bev",
            "radar_front",
            "lidar_bev"
        ],
        "skiplinks": {
            "camera_mono": true,
            "ir_image": true,
            "radar_bev": true,
            "radar_front": true,
            "lidar_bev": true
        },
        "backbones": {
            "camera_mono": {
                "name": "ResNet101",
                "weights": "IMAGENET1K_V2",
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            },
            "ir_image": {
                "name": "",
                "weights": "",
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            },
            "radar_bev": {
                "name": "ResNet50",
                "weights": "IMAGENET1K_V2",
                "in_channels": 6,
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            },
            "radar_front": {
                "name": "ResNet50",
                "weights": "IMAGENET1K_V2",
                "in_channels": 6,
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            },
            "lidar_bev": {
                "name": "ResNet50",
                "weights": "IMAGENET1K_V2",
                "in_channels": 3,
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": false
            }
        },
        "confidence": {
          "enabled": false,
          "camera_mono": {
            "type": "camera",
            "checkpoint": "/mnt/disk1/yangqilin/dpft/model/carmera_confidence_selector/confidence/20251224-154837-429_checkpoint_0100.pt",
            "selector": "/mnt/disk1/yangqilin/dpft/model/carmera_confidence_selector/selector/20251224-154837-429_checkpoint_0060.pt"
          },
          "ir_image": {
            "type": "ir_camera",
            "checkpoint": "",
            "selector": ""
          },
          "radar_bev": {
            "type": "radar",
            "checkpoint": "/mnt/disk1/yangqilin/dpft/model/radar_bev_confidence_selector/confidence/20251224-154905-039_checkpoint_0100.pt",
            "selector": "/mnt/disk1/yangqilin/dpft/model/radar_bev_confidence_selector/selector/20251224-154905-039_checkpoint_0060.pt"
          },
          "radar_front": {
            "type": "radar",
            "checkpoint": "/mnt/disk1/yangqilin/dpft/model/radar_front_confidence_selector/confidence/20251224-154928-915_checkpoint_0100.pt",
            "selector": "/mnt/disk1/yangqilin/dpft/model/radar_front_confidence_selector/selector/20251224-154928-915_checkpoint_0060.pt"
          },
          "lidar_bev": {
            "type": "lidar",
            "checkpoint": "/mnt/disk1/yangqilin/dpft/model/lidar_confidence_selector/confidence/20251224-155049-147_checkpoint_0100.pt",
            "selector": "/mnt/disk1/yangqilin/dpft/model/lidar_confidence_selector/selector/20251224-155049-147_checkpoint_0060.pt"
          }
        },

        "necks": {
            "camera_mono": {
                "name": "FPN",
                "in_channels_list": [
                    3,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels":16
            },
            "ir_image": {
                "name": "FPN",
                "in_channels_list": [
                    3,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels":16
            },
            "radar_bev": {
                "name": "FPN",
                "in_channels_list": [
                    6,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16
            },
            "radar_front": {
                "name": "FPN",
                "in_channels_list": [
                    6,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16
            },
            "lidar_bev": {
                "name": "FPN",
                "in_channels_list": [
                    3,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16,
                "channel_last": false
            }
        },
        "embeddings": {
            "camera_mono": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            },
            "ir_image": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            },
            "radar_bev": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            },
            "radar_front": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            },
            "lidar_bev": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            }
        },
        "querent": {
            "name": "data_agnostic_static_querent",
            "transformation": "spher2cart",
            "resolution": [
                20,
                20,
                1
            ],
            "minimum": [
                4,
                -50,
                0
            ],
            "maximum": [
                72,
                50,
                0
            ]
        },
        "fuser": {
            "name": "basefusion",
            "i_iter": 3,
            "m_views": 4,
            "d_model":16,
            "d_ffn": 32,
            "n_queries": 400,
            "n_levels": [
                5,
                5,
                5,
                5,
                5
            ],
            "n_heads": [
                1,
                1,
                1,
                1,
                1
            ],
            "n_points": [
                1,
                1,
                1,
                1,
                1
            ],
            "norm": true,
            "dropout": 0.2,
            "reduction": "weighted",
            "activation": "Mish"
        },
        "head": {
            "name": "bags_linear_detection_head",
            "in_channels": 16,
            "num_classes": 8,
            "num_reg_layers": 3,
            "num_cls_layers": 3,
            "bags": {
                "groups": [
                    [3, 4, 5, 7],
                    [2, 6],
                    [1]
                ],
                "background_weight": 0.1,
                "others_sample_ratio": 4
            }
        },
        "language_model": {
            "name": "qwen3_vl_8b",
            "model_id": "Qwen/Qwen3-VL-8B-Instruct",
            "cache_dir": "/mnt/disk1/yangqilin/dpft/VLM/QWen/",
            "enabled": true,
            "mode": "passthrough",
            "load_model": true,
            "reasoning_enabled": false,
            "attach_metadata": false
        }
    },

    "evaluate": {
            "logging": "epoch",
            "enable_visualization": true,
            "metrics": {
                "mAP": "mAP3D",
                "mGIoU": "mGIoU3D"
            },
            "use_weak_metric": true,
            "disable_exporter_in_weak_mode": true,
            "weak_metrics": {
                "weak": {
                    "name": "WeakBEVMetric",
                    "distance_threshold": 1.0,
                    "score_threshold": 0.3,
                    "ap_score_threshold": 0.0,
                    "nelem": 101
                }
            },
            "exporter": {
                "name": "kradar"
            }
        }
}
