{
    "dataset": "lh_pairs",
    "task": "2d_detection",
    "params_only": false,
    "computing": {
        "dtype": "float32",
        "seed": 42,
        "workers": 16,
        "device": "cuda:0"
    },
    "data": {
        "manifest": "/mnt/disk1/zhangzhibin/dataset/LH_pairs_dataset_auto_v2/scan_manifest.json",
        "homography": "/mnt/disk1/zhangzhibin/draw/H.npy",
        "image_size": 512,
        "max_time_diff": 0.25,
        "val_ratio": 0.2,
        "num_classes": 9,
        "categories": {
            "Background": 0,
            "Bridge": 1,
            "Building complex": 2,
            "Chimney": 3,
            "Power line": 4,
            "Power tower": 5,
            "Signal tower": 6,
            "Tall building": 7,
            "Wind turbine": 8
        },
        "label_aliases": {
            "building complex": "Building complex",
            "Building comlplex": "Building complex"
        },
        "subset": null
    },
    "train": {
        "batch_size": 32,
        "shuffle": true,
        "epochs": 200,
        "logging": "epoch",
        "criterion": "TwoDBAGSSetCriterion",
        "cost_class": 1.0,
        "cost_bbox": 1.0,
        "cost_giou": 1.0,
        "optimizer": {
            "name": "AdamW",
            "lr": 0.0002,
            "weight_decay": 0.01
        },
        "scheduler": {
            "name": "CosineAnnealingLR",
            "T_max": 200,
            "eta_min": 1e-05
        },
        "background_weight": 0.1,
        "others_sample_ratio": 4,
        "loss_weights": {
            "objectness": 1.0,
            "bags_class": 1.0,
            "bbox": 1.0,
            "giou": 1.0
        }
    },
    "model": {
        "name": "dprt",
        "inputs": [
            "camera_mono",
            "ir_image",
            "night_vision_image",
            "radar_bev",
            "radar_front",
            "lidar_bev"
        ],
        "input_enable": {
            "camera_mono": true,
            "ir_image": true,
            "radar_bev": false,
            "radar_front": false,
            "lidar_bev": false,
            "night_vision_image": false
        },
        "skiplinks": {
            "camera_mono": true,
            "ir_image": true,
            "radar_bev": true,
            "radar_front": true,
            "lidar_bev": true,
            "night_vision_image": true
        },
        "imagenet_normalize": true,
        "backbones": {
            "camera_mono": {
                "name": "ResNet101",
                "weights": "IMAGENET1K_V2",
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            },
            "ir_image": {
                "name": "ResNet101",
                "weights": "IMAGENET1K_V2",
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            },
            "radar_bev": {
                "name": "ResNet50",
                "weights": "IMAGENET1K_V2",
                "in_channels": 6,
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            },
            "radar_front": {
                "name": "ResNet50",
                "weights": "IMAGENET1K_V2",
                "in_channels": 6,
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            },
            "lidar_bev": {
                "name": "ResNet50",
                "weights": "IMAGENET1K_V2",
                "in_channels": 3,
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": false
            },
            "night_vision_image": {
                "name": "ResNet101",
                "weights": "IMAGENET1K_V2",
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            }
        },
        "confidence": {
            "enabled": false
        },
        "necks": {
            "camera_mono": {
                "name": "FPN",
                "in_channels_list": [
                    3,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16
            },
            "ir_image": {
                "name": "FPN",
                "in_channels_list": [
                    3,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16
            },
            "radar_bev": {
                "name": "FPN",
                "in_channels_list": [
                    6,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16
            },
            "radar_front": {
                "name": "FPN",
                "in_channels_list": [
                    6,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16
            },
            "lidar_bev": {
                "name": "FPN",
                "in_channels_list": [
                    3,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16,
                "channel_last": false
            },
            "night_vision_image": {
                "name": "FPN",
                "in_channels_list": [
                    3,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16
            }
        },
        "querent": {
            "name": "data_agnostic_static_querent",
            "transformation": null,
            "resolution": [
                20,
                20
            ],
            "minimum": [
                0.0,
                0.0
            ],
            "maximum": [
                1.0,
                1.0
            ]
        },
        "fuser": {
            "name": "rgb_ir_query_fusion",
            "i_iter": 3,
            "m_views": 2,
            "d_model": 16,
            "d_ffn": 32,
            "n_queries": 400,
            "n_levels": [
                5,
                5
            ],
            "n_heads": [
                1,
                1
            ],
            "n_points": [
                1,
                1
            ],
            "norm": true,
            "dropout": 0.2,
            "reduction": "weighted",
            "activation": "Mish",
            "inputs": [
                "camera_mono",
                "ir_image"
            ]
        },
        "head": {
            "name": "bags_2d_detection_head",
            "in_channels": 16,
            "num_classes": 9,
            "num_reg_layers": 3,
            "num_cls_layers": 3,
            "bags": {
                "groups": [
                    [
                        7,
                        8
                    ],
                    [
                        2,
                        4,
                        5
                    ],
                    [
                        3,
                        1,
                        6
                    ]
                ],
                "background_weight": 0.1,
                "others_sample_ratio": 4
            }
        },
        "language_model": {
            "name": "qwen_7b",
            "model_id": "/mnt/disk1/zhangzhibin/models/Qwen-7B",
            "enabled": false,
            "load_model": true,
            "keep_on_cpu": true,
            "cache_dir": "/mnt/disk1/zhangzhibin/models",
            "mode": "passthrough",
            "reasoning_enabled": false,
            "attach_metadata": false
        },
        "embeddings": {
            "camera_mono": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            },
            "ir_image": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            },
            "radar_bev": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            },
            "radar_front": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            },
            "lidar_bev": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            },
            "night_vision_image": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            }
        }
    },
    "evaluate": {
        "logging": "epoch",
        "metrics": {
            "mAP": {
                "name": "mAP2D",
                "threshold": 0.5,
                "score_threshold": 0.0
            }
        }
    }
}
