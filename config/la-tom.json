{
    "dataset": "lh_pairs",
    "task": "2d_detection",
    "computing": {
        "dtype": "float32",
        "seed": 42,
        "workers": 4,
        "device": "cuda:0"
    },
    "data": {
        "manifest": "/mnt/disk1/zhangzhibin/dataset/LH_pairs_dataset/scan_manifest.json",
        "homography": "/mnt/disk1/zhangzhibin/draw/H.npy",
        "image_size": 512,
        "max_time_diff": 0.25,
        "val_ratio": 0.2,
        "num_classes": 8,
        "categories": {
            "Background": 0,
            "Bridge": 1,
            "Building complex": 2,
            "Chimney": 3,
            "Power line": 4,
            "Power tower": 5,
            "Signal tower": 6,
            "Tall building": 7
        },
        "label_aliases": {
            "building complex": "Building complex",
            "Building comlplex": "Building complex"
        },
        "subset": null
    },
    "train": {
        "batch_size": 4,
        "shuffle": true,
        "epochs": 200,
        "logging": "epoch",
        "criterion": "TwoDBAGSSetCriterion",
        "cost_class": 1.0,
        "cost_bbox": 1.0,
        "cost_giou": 1.0,
        "optimizer": {
            "name": "AdamW",
            "lr": 0.0001,
            "weight_decay": 0.01
        },
        "scheduler": {
            "name": "CosineAnnealingLR",
            "T_max": 200,
            "eta_min": 1e-05
        },
        "background_weight": 0.1,
        "others_sample_ratio": 4,
        "loss_weights": {
            "objectness": 1.0,
            "bags_class": 1.0,
            "bbox": 1.0,
            "giou": 1.0
        }
    },
    "model": {
        "name": "rgb_ir_query_detector",
        "inputs": [
            "camera_mono",
            "ir_image"
        ],
        "d_model": 16,
        "num_queries": 400,
        "feature_levels": [
            "1",
            "2",
            "3",
            "4"
        ],
        "n_heads": 1,
        "n_points": 1,
        "dropout": 0.2,
        "imagenet_normalize": true,
        "backbones": {
            "camera_mono": {
                "name": "ResNet101",
                "weights": "IMAGENET1K_V2",
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            },
            "ir_image": {
                "name": "ResNet101",
                "weights": "IMAGENET1K_V2",
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            }
        },
        "confidence": {
            "enabled": false
        },
        "necks": {
            "camera_mono": {
                "name": "FPN",
                "in_channels_list": [
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16
            },
            "ir_image": {
                "name": "FPN",
                "in_channels_list": [
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16
            }
        },
        "head": {
            "name": "bags_linear_detection_head",
            "in_channels": 16,
            "num_classes": 8,
            "num_reg_layers": 3,
            "num_cls_layers": 3,
            "bags": {
                "groups": [
                    [
                        7
                    ],
                    [
                        2,
                        5,
                        4
                    ],
                    [
                        1,
                        6,
                        3
                    ]
                ],
                "background_weight": 0.1,
                "others_sample_ratio": 4
            },
            "bias": false,
            "dropout": 0.0
        }
    },
    "evaluate": {
        "logging": "epoch",
        "metrics": {
            "mAP": {
                "name": "mAP2D",
                "threshold": 0.5,
                "score_threshold": 0.05
            }
        }
    }
}
