{
    "dataset": "kradar",

    "computing": {
        "dtype": "float32",
        "seed": 42,
        "workers": 16,
        "device": "cuda:0"
    },

    "data": {
        "revision": "",
        "image_size": 512,
        "lidar": 1,
        "lidar_dropout": 0.0,
        "num_classes": 8,
        "categories": {
            "Sedan": 0,
            "Bus or Truck": 1,
            "Motorcycle": 2,
            "Bicycle": 3,
            "Bicycle Group": 4,
            "Pedestrian": 5,
            "Pedestrian Group": 6,
            "Background": -1
        },
        "fov": {
            "x": [
                0.0,
                72.0
            ],
            "y": [
                -6.4,
                6.4
            ],
            "z": [
                -2.0,
                6.0
            ],
            "azimuth": [
                -50,
                50
            ]
        }
    },

    "train": {
        "batch_size": 4,
        "shuffle": true,
        "epochs": 200,
        "logging": "epoch",
        "optimizer": {
            "name": "AdamW",
            "lr": 0.0001,
            "weight_decay": 0.01
        },
        "anassigner": "HungarianAnassigner",
        "criterion": "BalancedGroupSetCriterion",
        "background_weight": 0.1,
        "others_sample_ratio": 4,
        "loss_weights": {
            "objectness": 1.0,
            "bags_class": 1.0,
            "center": 1.0,
            "size": 1.0,
            "angle": 1.0
        },
        "scheduler": {
            "name": "ConstantLR",
            "factor": 1.0
        }


    },

    "model": {
        "name": "dprt",
        "inputs": [
            "camera_mono",
            "radar_bev",
            "radar_front",
            "lidar_bev"
        ],
        "skiplinks": {
            "camera_mono": true,
            "radar_bev": true,
            "radar_front": true,
            "lidar_bev": true
        },
        "backbones": {
            "camera_mono": {
                "name": "ResNet101",
                "weights": "IMAGENET1K_V2",
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            },
            "radar_bev": {
                "name": "ResNet50",
                "weights": "IMAGENET1K_V2",
                "in_channels": 6,
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            },
            "radar_front": {
                "name": "ResNet50",
                "weights": "IMAGENET1K_V2",
                "in_channels": 6,
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": true
            },
            "lidar_bev": {
                "name": "ResNet50",
                "weights": "IMAGENET1K_V2",
                "in_channels": 3,
                "multi_scale": 4,
                "norm_layer": "BatchNorm2d",
                "channel_last": false
            }
        },
        "necks": {
            "camera_mono": {
                "name": "FPN",
                "in_channels_list": [
                    3,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels":16
            },
            "radar_bev": {
                "name": "FPN",
                "in_channels_list": [
                    6,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16
            },
            "radar_front": {
                "name": "FPN",
                "in_channels_list": [
                    6,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16
            },
            "lidar_bev": {
                "name": "FPN",
                "in_channels_list": [
                    3,
                    256,
                    512,
                    1024,
                    2048
                ],
                "out_channels": 16,
                "channel_last": false
            }
        },
        "embeddings": {
            "camera_mono": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            },
            "radar_bev": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            },
            "radar_front": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            },
            "lidar_bev": {
                "name": "sinusoidal_embedding",
                "num_feats": 16,
                "n_levels": 5,
                "normalize": true
            }
        },
        "querent": {
            "name": "data_agnostic_static_querent",
            "transformation": "spher2cart",
            "resolution": [
                20,
                20,
                1
            ],
            "minimum": [
                4,
                -50,
                0
            ],
            "maximum": [
                72,
                50,
                0
            ]
        },
        "fuser": {
            "name": "IMPFusion",
            "i_iter": 4,
            "m_views": 4,
            "d_model":16,
            "d_ffn": 32,
            "n_queries": 400,
            "n_levels": [
                5,
                5,
                5,
                5
            ],
            "n_heads": [
                1,
                1,
                1,
                1
            ],
            "n_points": [
                1,
                1,
                1,
                1
            ],
            "norm": true,
            "dropout": 0.2,
            "reduction": "weighted",
            "activation": "Mish"
        },
        "head": {
            "name": "bags_linear_detection_head",
            "in_channels": 16,
            "num_classes": 8,
            "num_reg_layers": 3,
            "num_cls_layers": 3,
            "bags": {
                "groups": [
                    [3, 4, 5, 7],
                    [2, 6],
                    [1]
                ],
                "background_weight": 0.1,
                "others_sample_ratio": 4
            }
        }
    },

    "evaluate": {
            "logging": "epoch",
            "enable_visualization": true,
            "metrics": {
                "mAP": "mAP3D",
                "mGIoU": "mGIoU3D"
            },
            "exporter": {
                "name": "kradar"
            }
        }

}
